{"lines": [{"n": 1, "who": "ロゼ", "text": "雨の日は予想が外れやすい。", "sub": "雨の日は予想が\n外れやすい。", "t0": 0.3, "t1": 2.369, "visemes": [[0.331, 0.414, "aa"], [0.468, 0.547, "ee"], [0.589, 0.676, "oh"], [0.762, 0.814, "ih"], [0.85, 0.948, "aa"], [1.023, 1.091, "oh"], [1.189, 1.255, "oh"], [1.255, 1.343, "oh"], [1.394, 1.48, "aa"], [1.542, 1.612, "aa"], [1.687, 1.745, "ou"], [1.762, 1.848, "ee"], [1.895, 1.982, "aa"], [2.125, 2.201, "ou"], [2.201, 2.314, "ih"]]}, {"n": 2, "who": "ロゼ", "text": "その理由が「道悪」です。", "sub": "その理由が「道悪」です。", "t0": 2.619, "t1": 4.934, "visemes": [[2.772, 2.844, "oh"], [2.884, 2.983, "oh"], [3.011, 3.09, "ih"], [3.166, 3.244, "ou"], [3.244, 3.335, "ou"], [3.389, 3.546, "aa"], [3.755, 3.834, "ih"], [3.961, 4.012, "ih"], [4.046, 4.156, "aa"], [4.207, 4.334, "ou"], [4.511, 4.616, "ee"]]}, {"n": 3, "who": "ロゼ", "text": "道悪とは、雨で水を含んで走りにくくなった馬場のこと。", "sub": "道悪とは、\n雨で水を含んで\n走りにくくなった馬場のこと。", "t0": 5.234, "t1": 9.362, "visemes": [[5.294, 5.374, "ih"], [5.498, 5.553, "ih"], [5.581, 5.681, "aa"], [5.704, 5.772, "ou"], [5.85, 5.926, "oh"], [5.968, 6.141, "aa"], [6.31, 6.395, "aa"], [6.447, 6.526, "ee"], [6.563, 6.646, "ee"], [6.702, 6.782, "ih"], [6.866, 6.944, "ou"], [6.944, 7.064, "oh"], [7.271, 7.361, "ou"], [7.361, 7.449, "ou"], [7.475, 7.545, "ee"], [7.608, 7.653, "aa"], [7.759, 7.795, "ih"], [7.822, 7.897, "ih"], [7.948, 8.025, "ih"], [8.215, 8.263, "ou"], [8.309, 8.398, "aa"], [8.567, 8.633, "aa"], [8.67, 8.746, "aa"], [8.785, 8.863, "aa"], [8.906, 8.984, "oh"], [9.052, 9.115, "oh"], [9.203, 9.302, "oh"]]}, {"n": 4, "who": "ロゼ", "text": "馬場の状態は、4段階で発表されます。", "sub": "馬場の状態は、\n4段階で発表されます。", "t0": 9.662, "t1": 12.841, "visemes": [[9.704, 9.797, "aa"], [9.831, 9.922, "aa"], [9.967, 10.052, "oh"], [10.121, 10.188, "oh"], [10.188, 10.26, "oh"], [10.344, 10.454, "aa"], [10.454, 10.529, "ih"], [10.579, 10.75, "aa"], [10.97, 11.087, "oh"], [11.087, 11.172, "ou"], [11.185, 11.28, "aa"], [11.28, 11.342, "ou"], [11.408, 11.501, "aa"], [11.501, 11.569, "ih"], [11.618, 11.703, "ee